{
  "name": "fitmate",
  "private": true,
  "version": "0.1.0",
  "description": "Приложение для персонального тренера и клиентов",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fitmate/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}